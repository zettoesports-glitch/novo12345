void BMD::RenderVertexBufferSkinning(int i, Mesh_t* m, int vertex_index, vec3_t* vertices, vec2_t* textCoords, vec4_t* colors, int uMode, float alpha, float(*BoneMatrix)[3][4])
{
	GLuint shader_id = gShaderGL->GetShaderSkinningId();
	if (shader_id == 0)
		return;
	glUseProgram(shader_id);

	GLfloat fModelView[16];
	GLfloat fProjection[16];
	glGetFloatv(GL_MODELVIEW_MATRIX, fModelView);
	glGetFloatv(GL_PROJECTION_MATRIX, fProjection);

	glm::mat4 model = glm::mat4(1.0f);

	GLint locModel = glGetUniformLocation(shader_id, "model");
	GLint locView = glGetUniformLocation(shader_id, "view");
	GLint locProj = glGetUniformLocation(shader_id, "projection");
	glUniformMatrix4fv(locModel, 1, GL_FALSE, glm::value_ptr(model));
	glUniformMatrix4fv(locView, 1, GL_FALSE, fModelView);
	glUniformMatrix4fv(locProj, 1, GL_FALSE, fProjection);

	// Upload BoneMatrices[200] como mat4 array (OpenGL column-major)
	GLfloat boneMat4[200 * 16];
	for (int b = 0; b < NumBones && b < 200; b++)
	{
		for (int col = 0; col < 4; col++)
		{
			boneMat4[b * 16 + col * 4 + 0] = BoneMatrix[b][0][col];
			boneMat4[b * 16 + col * 4 + 1] = BoneMatrix[b][1][col];
			boneMat4[b * 16 + col * 4 + 2] = BoneMatrix[b][2][col];
			boneMat4[b * 16 + col * 4 + 3] = (col < 3) ? 0.0f : 1.0f;
		}
	}
	GLint locBones = glGetUniformLocation(shader_id, "BoneMatrices");
	glUniformMatrix4fv(locBones, NumBones > 200 ? 200 : NumBones, GL_FALSE, boneMat4);

	glUniform1i(glGetUniformLocation(shader_id, "uMode"), uMode);
	glUniform1f(glGetUniformLocation(shader_id, "Alpha"), alpha);

	glActiveTexture(GL_TEXTURE0);
	gShaderGL->setInt("texture1", 0);

	// Render com VAO (vertices ja estao no VBO, sem glBufferSubData!)
	glBindVertexArray(m->VAO);
	glDrawElements(GL_TRIANGLES, vertex_index, GL_UNSIGNED_SHORT, 0);
	glBindVertexArray(0);
	glUseProgram(0);
}
